# Copy to .env.local (never commit it) and add the same values in Vercel → Settings → Environment Variables.

# ── Database (Supabase → Project Settings → Database → Connection string) ──
# Use the SESSION pooler (port 5432) for both. The Transaction pooler (port 6543) stalls this
# app's parallel page queries. Remove the [ ] around the password.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Used by `npm run db:migrate` (can be the same link)
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Local development without Supabase: embedded Postgres stored in ./.pglite
# DATABASE_URL="pglite:./.pglite"

# ── Supabase Auth + Storage (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."   # or the legacy anon key
SUPABASE_SECRET_KEY="sb_secret_..."                          # or the legacy service_role key — server only!

# Public URL of the deployed site (used in login emails)
NEXT_PUBLIC_SITE_URL="https://viking-warriors.vercel.app"

# ── Nightly sync ──
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="generate-with: openssl rand -hex 32"

# ── Google Sheets (Google Cloud → Service account → Keys → JSON) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL="viking-sheets@<project>.iam.gserviceaccount.com"
# Paste the private_key from the JSON, keeping the \n sequences, inside double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Local development only ──
# Act as this admin without logging in (ignored in production)
# DEV_ADMIN_EMAIL="arunsha0007@gmail.com"
